{
  "mcpServers": {
    "knowledge": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/knowledge"],
      "transport": "stdio"
    },
    "web-search": {
      "command": "npx",
      "args": ["-y", "@anthropic/mcp-server-web-search"],
      "env": {
        "SEARCH_API_KEY": "your-api-key"
      },
      "transport": "stdio"
    },
    "vector-db": {
      "transport": "sse",
      "url": "http://localhost:8080/sse"
    }
  }
}
